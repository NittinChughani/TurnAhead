rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // v2.5: Per-doctor lanes, atomic counter actions, persistent call receipts and v2.4-compatible tickets. Doctor directory restricted to staff, private dated archives owner-only, named QR links are bearer secrets.
    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true && request.auth.token.email is string; }
    function email() { return request.auth.token.email.lower(); }
    // Time-limited compatibility for the existing live v2.0 pilot during rollout.
    function legacyStaff() {
      return signedIn() && request.time < timestamp.date(2026, 12, 12) &&
        exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.active == true;
    }
    function memberPath(hid,uid) {
      return /databases/$(database)/documents/memberships/$(hid + '_' + uid);
    }
    function hospitalPath(hid) { return /databases/$(database)/documents/hospitals/$(hid); }
    function invitePath(hid,mail) { return /databases/$(database)/documents/hospitals/$(hid)/invites/$(mail); }
    function ticketPath(hid,id) { return /databases/$(database)/documents/hospitals/$(hid)/tickets/$(id); }
    function doctorPath(hid,id) { return /databases/$(database)/documents/hospitals/$(hid)/doctors/$(id); }
    function isMember(hid) {
      return verified() && exists(memberPath(hid,request.auth.uid)) &&
        get(memberPath(hid,request.auth.uid)).data.active == true &&
        get(memberPath(hid,request.auth.uid)).data.hospitalId == hid &&
        get(memberPath(hid,request.auth.uid)).data.uid == request.auth.uid;
    }
    function role(hid) { return get(memberPath(hid,request.auth.uid)).data.role; }
    function manager(hid) { return isMember(hid) && role(hid) in ['owner','supervisor']; }
    function admin(hid) { return owner(hid); }
    function owner(hid) { return isMember(hid) && role(hid) == 'owner' && get(hospitalPath(hid)).data.ownerUid == request.auth.uid; }
    // Public hospital branding; only the verified owner may update it.
    function validCustomization(c) {
      return c is map &&
        c.keys().hasAll(['logo','accent','receiptNote','opens','closes','hoursEnabled','counters','boardLayout','boardMessage']) &&
        c.keys().hasOnly(['logo','accent','receiptNote','opens','closes','hoursEnabled','counters','boardLayout','boardMessage']) &&
        c.logo is string && c.logo.size() <= 65000 &&
        (c.logo == '' || c.logo.matches('^data:image/(webp|jpeg|png);base64,[A-Za-z0-9+/]+={0,2}$')) &&
        c.accent is string && c.accent.matches('^#[0-9a-fA-F]{6}$') &&
        c.receiptNote is string && c.receiptNote.size() <= 120 &&
        c.boardMessage is string && c.boardMessage.size() <= 120 &&
        c.opens is string && c.opens.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
        c.closes is string && c.closes.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
        c.hoursEnabled is bool && (!c.hoursEnabled || c.opens != c.closes) &&
        c.counters is int && c.counters >= 1 && c.counters <= 12 &&
        c.boardLayout in ['standard','large'];
    }
    function validHospital(data) {
      return data.keys().hasOnly(['name','ownerUid','status','createdAt','updatedAt','recallGraceMinutes','customization']) &&
        data.name is string && data.name.size() >= 3 && data.name.size() <= 70 &&
        data.ownerUid is string && data.status == 'active' &&
        data.createdAt is timestamp && data.updatedAt is timestamp &&
        data.get('recallGraceMinutes',10) is int && data.get('recallGraceMinutes',10) >= 1 && data.get('recallGraceMinutes',10) <= 120 &&
        (!('customization' in data) || validCustomization(data.customization));
    }
    function validAvatar(data) {
      return !('profilePhoto' in data) || (data.profilePhoto is string &&
        data.profilePhoto.size() <= 65000 &&
        (data.profilePhoto == '' || data.profilePhoto.matches('^data:image/(webp|jpeg|png);base64,[A-Za-z0-9+/=]+$')));
    }
    function validMembership(data,hid,uid) {
      return data.keys().hasOnly(['uid','hospitalId','email','role','active','createdAt','updatedAt','invitedBy','displayName','gender','profilePhoto']) &&
        data.uid == uid && data.hospitalId == hid && data.email is string &&
        data.email.size() <= 254 && data.role in ['owner','supervisor','receptionist'] &&
        data.active is bool && data.createdAt is timestamp &&
        data.updatedAt is timestamp && data.invitedBy is string &&
        data.get('displayName','') is string && data.get('displayName','').size() <= 70 &&
        data.get('gender','unspecified') in ['male','female','unspecified'] && validAvatar(data);
    }
    function validInvite(data,mail) {
      return data.keys().hasOnly(['email','role','status','createdBy','createdAt','expiresAt','acceptedUid','acceptedAt','displayName','gender']) &&
        data.email == mail && data.email is string && data.email.size() <= 254 &&
        data.role in ['supervisor','receptionist'] &&
        data.status == 'pending' && data.createdBy == request.auth.uid &&
        data.createdAt == request.time && data.expiresAt is timestamp &&
        data.expiresAt > request.time &&
        data.acceptedUid == null && data.acceptedAt == null &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 70)) &&
        (!('gender' in data) || data.gender in ['male','female']);
    }
    function validQueue(data) {
      return data.keys().hasOnly(['name','prefix','dayKey','lastNumber','waitingNumbers','active','served','avgMinutes','paused','createdAt','updatedAt','lanes']) &&
        data.get('lanes',{}) is map && data.get('lanes',{}).size() <= 100 &&
        data.name is string && data.name.size() >= 3 && data.name.size() <= 45 &&
        data.prefix is string && data.dayKey is string &&
        data.lastNumber is int && data.lastNumber >= -1 && data.lastNumber <= 999999 &&
        data.waitingNumbers is list && data.waitingNumbers.size() <= 2000 &&
        data.served is int && data.avgMinutes is int && data.paused is bool &&
        data.createdAt is number && data.updatedAt is number;
    }
    function validControl(data) {
      return data.keys().hasOnly(['pending','activeId','activeSince','lanes']) &&
        data.get('lanes',{}) is map && data.get('lanes',{}).size() <= 100 &&
        data.pending is list && data.pending.size() <= 2000;
    }
    function validDoctor(data) {
      return data.keys().hasOnly(['name','departmentId','departmentName','roomNumber','active','createdAt','updatedAt']) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
        data.departmentId is string && data.departmentId.size() >= 3 && data.departmentId.size() <= 64 &&
        data.departmentName is string && data.departmentName.size() >= 3 && data.departmentName.size() <= 45 &&
        data.roomNumber is string && data.roomNumber.size() <= 20 &&
        data.active is bool && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    // v2.3 tickets remain readable and may be completed during a rules-first rollout.
    // New doctor fields are validated when present, and the registered doctor is verified on create.
    function validTicket(data) {
      return data.keys().hasOnly(['queueId','queueName','code','number','dayKey','status','createdAt','calledAt','finishedAt','patientName','attendance','patientGender','doctorId','doctorName','roomNumber','calledCounter','missedAt','recalledAt','recallCount','changeId','originQueueId']) &&
        (!('changeId' in data) || (data.changeId is string && data.changeId.size() == 20)) &&
        (!('originQueueId' in data) || (data.originQueueId is string && data.originQueueId.size() >= 3 && data.originQueueId.size() <= 64)) &&
        data.get('recallCount',0) is int && data.get('recallCount',0) >= 0 && data.get('recallCount',0) <= 1 &&
        (!('missedAt' in data) || data.missedAt is number) &&
        (!('recalledAt' in data) || data.recalledAt is number) &&
        (!('calledCounter' in data) || (data.calledCounter is string && data.calledCounter.matches('^Counter (?:[1-9]|1[0-2])$'))) &&
        data.queueId is string && data.queueName is string && data.code is string &&
        data.number is int && data.number >= 0 && data.dayKey is string &&
        data.status in ['waiting','called','completed','skipped'] && data.createdAt is number &&
        data.get('patientName','') is string && data.get('patientName','').size() <= 80 &&
        data.get('attendance','pending') in ['pending','present','missed'] &&
        (!('patientGender' in data) || data.patientGender in ['male','female']) &&
        (!('doctorId' in data) || (data.doctorId is string && data.doctorId.size() == 20)) &&
        (!('doctorName' in data) || (data.doctorName is string && data.doctorName.size() >= 2 && data.doctorName.size() <= 80)) &&
        (!('roomNumber' in data) || (data.roomNumber is string && data.roomNumber.size() >= 1 && data.roomNumber.size() <= 20));
    }
    function validDoctorOnNewTicket(hid,data) {
      // Accept old v2.3 ticket writes only during the coordinated rollout.
      return !('doctorId' in data) || (
        ('patientGender' in data) && ('roomNumber' in data) && ('doctorName' in data) &&
        exists(doctorPath(hid,data.doctorId)) &&
        get(doctorPath(hid,data.doctorId)).data.active == true &&
        get(doctorPath(hid,data.doctorId)).data.departmentId == data.queueId &&
        get(doctorPath(hid,data.doctorId)).data.name == data.doctorName
      );
    }
    function validHistoryRecord(data,hid,day,qid,ticketId) {
      return data.keys().hasOnly(['ticketId','queueId','queueName','code','number','dayKey','patientName','status','attendance','issuedAt','calledAt','finishedAt','updatedAt','patientGender','doctorId','doctorName','roomNumber','calledCounter','calledBy','finishedBy','issuedBy','issuedCounter','missedAt','recalledAt','recallCount','serviceQueueId','serviceQueueName','serviceCode','serviceNumber']) &&
        data.get('recallCount',0) is int && data.get('recallCount',0) >= 0 && data.get('recallCount',0) <= 1 &&
        (!('missedAt' in data) || data.missedAt is number) &&
        (!('recalledAt' in data) || data.recalledAt is number) &&
        data.get('issuedBy','') is string &&
        (!('issuedCounter' in data) || (data.issuedCounter is string && data.issuedCounter.matches('^Counter (?:[1-9]|1[0-2])$'))) &&
        data.get('calledBy','') is string && data.get('finishedBy','') is string &&
        (!('calledCounter' in data) || (data.calledCounter is string && (data.calledCounter == '' || data.calledCounter.matches('^Counter (?:[1-9]|1[0-2])$')))) &&
        data.ticketId == ticketId && data.queueId == qid && data.dayKey == day &&
        getAfter(ticketPath(hid,ticketId)).data.get('originQueueId',getAfter(ticketPath(hid,ticketId)).data.queueId) == qid &&
        data.get('serviceQueueId',data.queueId) == getAfter(ticketPath(hid,ticketId)).data.queueId &&
        data.get('serviceQueueName',data.queueName) == getAfter(ticketPath(hid,ticketId)).data.queueName &&
        data.get('serviceCode',data.code) == getAfter(ticketPath(hid,ticketId)).data.code &&
        data.get('serviceNumber',data.number) == getAfter(ticketPath(hid,ticketId)).data.number &&
        data.queueName is string && data.code is string && data.number is int &&
        data.patientName is string && data.patientName.size() >= 2 && data.patientName.size() <= 80 &&
        data.status in ['waiting','called','completed','skipped'] && data.attendance in ['pending','present','missed'] &&
        data.issuedAt is number && data.updatedAt is number &&
        (!('patientGender' in data) || data.patientGender in ['male','female']) &&
        (!('doctorId' in data) || (data.doctorId is string && data.doctorId.size() == 20)) &&
        (!('doctorName' in data) || (data.doctorName is string && data.doctorName.size() >= 2 && data.doctorName.size() <= 80)) &&
        (!('roomNumber' in data) || (data.roomNumber is string && data.roomNumber.size() >= 1 && data.roomNumber.size() <= 20)) &&
        // The ticket snapshot must agree with the private archive.
        getAfter(ticketPath(hid,ticketId)).data.status == data.status &&
        getAfter(ticketPath(hid,ticketId)).data.get('doctorId','') == data.get('doctorId','') &&
        getAfter(ticketPath(hid,ticketId)).data.get('roomNumber','') == data.get('roomNumber','') &&
        getAfter(ticketPath(hid,ticketId)).data.get('patientGender','') == data.get('patientGender','');
    }
    function validRecall(hid, old, incoming, ticketId) {
      return old.status == 'skipped' && old.get('recallCount',0) == 0 &&
        old.finishedAt is number && old.finishedAt <= request.time.toMillis() &&
        request.time.toMillis() - old.finishedAt <= get(hospitalPath(hid)).data.get('recallGraceMinutes',10) * 60000 &&
        incoming.status == 'waiting' && incoming.attendance == 'pending' &&
        incoming.calledAt == null && incoming.finishedAt == null &&
        incoming.missedAt == old.finishedAt && incoming.recallCount == 1 &&
        incoming.recalledAt is number && incoming.recalledAt <= request.time.toMillis() + 120000 &&
        incoming.recalledAt >= request.time.toMillis() - 120000 &&
        incoming.diff(old).affectedKeys().hasOnly(['status','attendance','calledAt','finishedAt','calledCounter','missedAt','recalledAt','recallCount']) &&
        getAfter(/databases/$(database)/documents/hospitals/$(hid)/queues/$(old.queueId)).data.waitingNumbers.hasAny([old.number]);
    }

    function changePath(hid,id) { return /databases/$(database)/documents/hospitals/$(hid)/ticketChanges/$(id); }
    function archivePath(hid,day,qid,id) { return /databases/$(database)/documents/hospitals/$(hid)/history/$(day)/departments/$(qid)/records/$(id); }
    function controlPath(hid,qid) { return /databases/$(database)/documents/hospitals/$(hid)/controls/$(qid); }
    function queuePath(hid,qid) { return /databases/$(database)/documents/hospitals/$(hid)/queues/$(qid); }
    function matchingChangeArchive(hid,t,id) {
      let a = getAfter(archivePath(hid,t.dayKey,t.get('originQueueId',t.queueId),id)).data;
      return a.patientName == t.patientName && a.patientGender == t.patientGender &&
        a.roomNumber == t.roomNumber && a.doctorId == t.doctorId && a.doctorName == t.doctorName &&
        a.status == 'waiting' && a.get('serviceCode',a.code) == t.code &&
        a.get('serviceQueueId',a.queueId) == t.queueId && a.get('serviceNumber',a.number) == t.number;
    }
    function validLaneTransfer(hid,old,t,id) {
      let q = getAfter(queuePath(hid,t.queueId)).data;
      let c = getAfter(controlPath(hid,t.queueId)).data;
      let pending = {'id':id,'number':t.number};
      return !q.paused && !q.lanes[t.doctorId].paused &&
        !q.lanes[old.doctorId].waitingNumbers.hasAny([t.number]) &&
        q.lanes[t.doctorId].waitingNumbers.hasAny([t.number]) &&
        !c.lanes[old.doctorId].pending.hasAny([pending]) &&
        c.lanes[t.doctorId].pending.hasAny([pending]);
    }
    function validDepartmentTransfer(hid,old,t,id) {
      let source = getAfter(queuePath(hid,old.queueId)).data;
      let dest = getAfter(queuePath(hid,t.queueId)).data;
      let sc = getAfter(controlPath(hid,old.queueId)).data;
      let dc = getAfter(controlPath(hid,t.queueId)).data;
      return old.queueId != t.queueId && old.doctorId != t.doctorId &&
        t.originQueueId == old.get('originQueueId',old.queueId) &&
        source.dayKey == old.dayKey && dest.dayKey == old.dayKey &&
        !dest.paused && !dest.lanes[t.doctorId].paused &&
        dest.name == t.queueName && dest.lastNumber == t.number &&
        t.number == get(queuePath(hid,t.queueId)).data.lastNumber + 1 &&
        t.code.matches('^' + dest.prefix + '-[0-9]+$') &&
        !source.waitingNumbers.hasAny([old.number]) &&
        !source.lanes[old.doctorId].waitingNumbers.hasAny([old.number]) &&
        !sc.lanes[old.doctorId].pending.hasAny([{'id':id,'number':old.number}]) &&
        dest.waitingNumbers.hasAny([t.number]) &&
        dest.lanes[t.doctorId].waitingNumbers.hasAny([t.number]) &&
        dc.lanes[t.doctorId].pending.hasAny([{'id':id,'number':t.number}]);
    }
    function validTicketChange(hid,old,t,id) {
      let e = getAfter(changePath(hid,t.changeId)).data;
      let changed = t.diff(old).affectedKeys();
      return old.status == 'waiting' && t.status == 'waiting' &&
        t.changeId != old.get('changeId','') && !exists(changePath(hid,t.changeId)) &&
        e.ticketId == id && e.actorUid == request.auth.uid && e.createdAt == request.time &&
        e.fromDoctor == old.doctorId && e.toDoctor == t.doctorId &&
        matchingChangeArchive(hid,t,id) &&
        ((e.kind == 'correction' && get(queuePath(hid,old.queueId)).data.dayKey == old.dayKey && changed.hasOnly(['patientName','patientGender','roomNumber','changeId']) &&
          changed.hasAny(['patientName','patientGender','roomNumber']) && t.patientName.size() >= 2) ||
         (e.kind == 'transfer' && get(queuePath(hid,old.queueId)).data.dayKey == old.dayKey && changed.hasOnly(['doctorId','doctorName','roomNumber','changeId']) &&
          old.doctorId != t.doctorId && validDoctorOnNewTicket(hid,t) && validLaneTransfer(hid,old,t,id)) ||
         (e.kind == 'department-transfer' && changed.hasOnly(['originQueueId','queueId','queueName','number','code','doctorId','doctorName','roomNumber','changeId']) &&
          validDoctorOnNewTicket(hid,t) && validDepartmentTransfer(hid,old,t,id)));
    }

    match /hospitals/{hid} {
      // Public landing/board can fetch a *known* hospital ID, never enumerate hospitals.
      allow get: if true;
      allow list, delete: if false;
      // Operator-provisioned only; browser users cannot register a hospital or an owner.
      allow create: if false;
      allow update: if admin(hid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','updatedAt','recallGraceMinutes','customization']) &&
        validHospital(request.resource.data) && request.resource.data.updatedAt == request.time;

      match /invites/{mail} {
        allow get: if admin(hid) || (verified() && email() == mail);
        allow list: if admin(hid);
        allow create: if admin(hid) && validInvite(request.resource.data,mail);
        allow update: if (
          // Administrator revokes an outstanding invitation.
          (admin(hid) && resource.data.status == 'pending' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
            request.resource.data.status == 'revoked') ||
          // Administrator resends a previously revoked/pending invitation.
          (admin(hid) && resource.data.status in ['pending','revoked'] &&
            validInvite(request.resource.data,mail)) ||
          // Verified invitee claims invitation; membership creation is atomic.
          (verified() && email() == mail && resource.data.status == 'pending' &&
            resource.data.expiresAt > request.time &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','acceptedUid','acceptedAt']) &&
            request.resource.data.status == 'accepted' &&
            request.resource.data.acceptedUid == request.auth.uid &&
            request.resource.data.acceptedAt == request.time &&
            getAfter(memberPath(hid,request.auth.uid)).data.role == resource.data.role &&
            getAfter(memberPath(hid,request.auth.uid)).data.active == true)
        );
        allow delete: if false;
      }

      match /queues/{queueId} {
        allow get, list: if true;
        allow create: if manager(hid) && validQueue(request.resource.data);
        allow update: if isMember(hid) && validQueue(request.resource.data);
        allow delete: if false;
      }
      match /controls/{queueId} {
        allow get: if isMember(hid);
        allow list: if false;
        allow create: if manager(hid) && validControl(request.resource.data);
        allow update: if isMember(hid) && validControl(request.resource.data);
        allow delete: if false;
      }
      match /doctors/{doctorId} {
        // Patient tickets embed doctor snapshots, but browsing the doctor directory requires staff membership.
        allow get, list: if isMember(hid);
        allow create: if owner(hid) && validDoctor(request.resource.data) &&
          request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
        allow update: if owner(hid) && validDoctor(request.resource.data) &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.departmentId == resource.data.departmentId &&
          request.resource.data.updatedAt == request.time;
        // Soft-delete to keep historical ticket links and archived records meaningful.
        allow delete: if false;
      }
      match /tickets/{ticketId} {
        // Bearer QR link includes patient name, doctor and room; keep the unpredictable link private.
        allow get: if true;
        allow list: if isMember(hid);
        allow create: if isMember(hid) && validTicket(request.resource.data) &&
          !('originQueueId' in request.resource.data) && !('changeId' in request.resource.data) && validDoctorOnNewTicket(hid,request.resource.data);
        allow update: if isMember(hid) && validTicket(request.resource.data) &&
          // Reception can advance status, never rewrite patient/doctor/room history.
          ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','attendance','calledAt','finishedAt','calledCounter']) &&
            ((resource.data.status == 'waiting' && request.resource.data.status == 'called' &&
              request.resource.data.calledAt is number) ||
             (resource.data.status == 'called' && request.resource.data.status in ['completed','skipped'] &&
              request.resource.data.finishedAt is number &&
              request.resource.data.attendance == (request.resource.data.status == 'completed' ? 'present' : 'missed')))) ||
           validRecall(hid,resource.data,request.resource.data,ticketId) ||
           validTicketChange(hid,resource.data,request.resource.data,ticketId));
        allow delete: if false;
      }
      match /ticketChanges/{changeId} {
        allow get, list: if owner(hid);
        allow create: if isMember(hid) &&
          request.resource.data.keys().hasOnly(['kind','ticketId','actorUid','fromDoctor','toDoctor','createdAt']) &&
          request.resource.data.keys().hasAll(['kind','ticketId','actorUid','fromDoctor','toDoctor','createdAt']) &&
          request.resource.data.kind in ['correction','transfer','department-transfer'] &&
          request.resource.data.ticketId is string && request.resource.data.ticketId.size() == 20 &&
          request.resource.data.actorUid == request.auth.uid && request.resource.data.createdAt == request.time &&
          get(ticketPath(hid,request.resource.data.ticketId)).data.get('changeId','') != changeId &&
          getAfter(ticketPath(hid,request.resource.data.ticketId)).data.changeId == changeId;
        allow update, delete: if false;
      }
      // Feedback is immutable, one private response per completed bearer-QR ticket.
      // Device clock skew must not block feedback once a ticket is completed.
      match /feedback/{ticketId} {
        allow get, list: if owner(hid);
        allow create: if exists(ticketPath(hid,ticketId)) &&
          get(ticketPath(hid,ticketId)).data.status == 'completed' &&
          get(ticketPath(hid,ticketId)).data.finishedAt is number &&
          request.resource.data.keys().hasOnly(['ticketId','rating','note','createdAt']) &&
          request.resource.data.ticketId == ticketId &&
          request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
          request.resource.data.note is string && request.resource.data.note.size() <= 300 &&
          request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
      match /history/{date} {
        // Every day's index is written at first ticket issue, not by an unreliable browser cron.
        // Staff may check existence of a day marker before issuing a ticket;
        // only the owner may enumerate days or read named records.
        allow get: if isMember(hid);
        allow list: if owner(hid);
        allow create: if isMember(hid) && request.resource.data.keys().hasOnly(['dayKey','createdAt']) &&
          request.resource.data.dayKey == date && request.resource.data.createdAt is number;
        allow update, delete: if false;
        match /departments/{qid}/records/{ticketId} {
          allow get, list: if owner(hid);
          allow create: if isMember(hid) && validHistoryRecord(request.resource.data,hid,date,qid,ticketId) &&
            // The issuer UID is verified by rules. Both fields are optional only for pre-upgrade clients.
            (('issuedBy' in request.resource.data && 'issuedCounter' in request.resource.data &&
                request.resource.data.issuedBy == request.auth.uid) ||
             (!('issuedBy' in request.resource.data) && !('issuedCounter' in request.resource.data))) &&
            getAfter(ticketPath(hid,ticketId)).data.patientName == request.resource.data.patientName &&
            getAfter(ticketPath(hid,ticketId)).data.code == request.resource.data.code;
          allow update: if isMember(hid) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','attendance','calledAt','finishedAt','updatedAt','calledCounter','calledBy','finishedBy','missedAt','recalledAt','recallCount']) &&
            (!('calledBy' in request.resource.data) || request.resource.data.calledBy == request.auth.uid || resource.data.get('calledBy','') == request.resource.data.calledBy) &&
            (!('finishedBy' in request.resource.data) || request.resource.data.finishedBy == request.auth.uid || resource.data.get('finishedBy','') == request.resource.data.finishedBy) &&
            validHistoryRecord(request.resource.data,hid,date,qid,ticketId) &&
            getAfter(ticketPath(hid,ticketId)).data.attendance == request.resource.data.attendance ||
          (isMember(hid) && resource.data.status == 'waiting' &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['patientName','patientGender','doctorId','doctorName','roomNumber','updatedAt','serviceQueueId','serviceQueueName','serviceCode','serviceNumber']) &&
           validHistoryRecord(request.resource.data,hid,date,qid,ticketId) &&
           getAfter(ticketPath(hid,ticketId)).data.get('changeId','') != get(ticketPath(hid,ticketId)).data.get('changeId','') &&
           getAfter(ticketPath(hid,ticketId)).data.patientName == request.resource.data.patientName &&
           getAfter(ticketPath(hid,ticketId)).data.doctorName == request.resource.data.doctorName &&
           getAfter(ticketPath(hid,ticketId)).data.attendance == request.resource.data.attendance);
          allow delete: if false;
        }
      }
      match /prefixes/{prefix} {
        allow get: if manager(hid);
        allow list, update, delete: if false;
        allow create: if manager(hid) && prefix.matches('^[A-Z]{3}$') &&
          request.resource.data.keys().hasOnly(['queueId']) && request.resource.data.queueId is string;
      }
      match /meta/{key} {
        allow get: if isMember(hid) && key == 'sequence';
        allow list, delete: if false;
        allow create, update: if manager(hid) && key == 'sequence' &&
          request.resource.data.keys().hasOnly(['nextPrefix']) &&
          request.resource.data.nextPrefix is int && request.resource.data.nextPrefix >= 1;
      }
    }

    match /memberships/{memberId} {
      allow get: if verified() &&
        (resource.data.uid == request.auth.uid || admin(resource.data.hospitalId));
      // Client queries MUST filter by uid (self) or hospitalId (hospital admin).
      allow list: if verified() &&
        (resource.data.uid == request.auth.uid || admin(resource.data.hospitalId));
      allow create: if verified() && memberId == request.resource.data.hospitalId + '_' + request.auth.uid &&
        validMembership(request.resource.data,request.resource.data.hospitalId,request.auth.uid) &&
        request.resource.data.email == email() && request.resource.data.active == true &&
        request.resource.data.createdAt == request.time &&
        // Self-activation requires a pending invitation for this verified email.
        request.resource.data.role in ['supervisor','receptionist'] &&
        get(invitePath(request.resource.data.hospitalId,email())).data.status == 'pending' &&
        get(invitePath(request.resource.data.hospitalId,email())).data.role == request.resource.data.role &&
        get(invitePath(request.resource.data.hospitalId,email())).data.createdBy == request.resource.data.invitedBy &&
        get(invitePath(request.resource.data.hospitalId,email())).data.get('displayName',request.resource.data.get('displayName','')) == request.resource.data.get('displayName','') &&
        get(invitePath(request.resource.data.hospitalId,email())).data.get('gender',request.resource.data.get('gender','unspecified')) == request.resource.data.get('gender','unspecified') &&
        get(invitePath(request.resource.data.hospitalId,email())).data.expiresAt > request.time &&
        getAfter(invitePath(request.resource.data.hospitalId,email())).data.status == 'accepted' &&
        getAfter(invitePath(request.resource.data.hospitalId,email())).data.acceptedUid == request.auth.uid;

      allow update: if (verified() && request.auth.uid == resource.data.uid &&
        isMember(resource.data.hospitalId) && validAvatar(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profilePhoto','updatedAt']) &&
        request.resource.data.updatedAt == request.time) ||
        (verified() && owner(resource.data.hospitalId) &&
        resource.data.role != 'owner' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','active','updatedAt','displayName','gender']) &&
        request.resource.data.role in ['supervisor','receptionist'] &&
        request.resource.data.active is bool &&
        request.resource.data.get('displayName','') is string &&
        request.resource.data.get('displayName','').size() <= 70 &&
        request.resource.data.get('gender','unspecified') in ['male','female','unspecified'] &&
        request.resource.data.updatedAt == request.time);
      allow delete: if false;
    }

    // v2.0 compatibility expires 12 December 2026. This allows a safe,
    // rules-first rollout; it must be removed after existing queues finish.
    // Legacy patient reads remain available by unpredictable ticket ID.
    match /tickets/{ticketId} {
      allow get: if true;
      allow list: if legacyStaff();
      allow create, update: if legacyStaff() && validTicket(request.resource.data);
      allow delete: if false;
    }
    match /queues/{queueId} {
      allow get, list: if true;
      allow create, update: if legacyStaff() && validQueue(request.resource.data);
      allow delete: if false;
    }
    match /staff/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /controls/{id} {
      allow get: if legacyStaff();
      allow list: if false;
      allow create, update: if legacyStaff() && validControl(request.resource.data);
      allow delete: if false;
    }
    match /meta/{id} {
      allow get: if legacyStaff() && id == 'sequence';
      allow list, delete: if false;
      allow create, update: if legacyStaff() && id == 'sequence' &&
        request.resource.data.keys().hasOnly(['nextPrefix']) &&
        request.resource.data.nextPrefix is int && request.resource.data.nextPrefix >= 1;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
